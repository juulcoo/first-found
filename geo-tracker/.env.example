# Kopieer dit bestand naar .env en vul je eigen keys in. Commit .env nooit naar git.
# Heb je nog niet alle vier? Geen probleem — laat de ontbrekende regels
# leeg en gebruik --providers om alleen de providers te draaien waar je
# een key voor hebt, bv.: python main.py run --client <slug> --providers claude

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...
GEMINI_API_KEY=AIza...
